# mirrored from the content/ submodule's content/images/projects/ on every
# build. Image optimization itself lives in the portfolio-content repo.
/public/images/projects/*

# macOS-specific files
.DS_Store
Thumbs.db

# jetbrains setting folder
.idea/

# TypeScript incremental compilation info
*.tsbuildinfo
