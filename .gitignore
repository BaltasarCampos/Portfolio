# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables — NEVER commit these
.env
.env.local
.env.*.local
.env.production

# test artifacts
coverage/
playwright-report/
test-results/

# Generated by scripts/sync-content-images.ts (prebuild), mirrored from the
# content/ submodule's content/images/projects/ on every build. The src/
# subdirectory is exempted: it's the source-of-truth staging area for
# scripts/optimize-images.ts's raw, un-optimized originals, not a build output.
/public/images/projects/*
!/public/images/projects/src

# macOS-specific files
.DS_Store
Thumbs.db

# jetbrains setting folder
.idea/

# TypeScript incremental compilation info
*.tsbuildinfo
